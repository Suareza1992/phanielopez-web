# Copy to .env for local development (never commit .env). In production set these as host variables.

# Public address of the site — used in "forgot password" and invite links.
SITE_URL=http://localhost:5196

# Where the database (phanie.db) and uploaded photos live. In production: the persistent volume, e.g. /data
# DATA_DIR=/data

# Email for "forgot password" (Resend). Without these, local dev prints the email to the terminal,
# and production hides/blocks the forgot-password flow.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Phanie López <no-reply@phanielopez.com>"

# NODE_ENV=production
# PORT=5196
